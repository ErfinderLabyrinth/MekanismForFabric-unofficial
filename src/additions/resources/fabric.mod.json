{
  "schemaVersion": 1,
  "id": "mekanismadditions",
  "version": "${version}",
  "name": "MekanismForFabric: Additions",
  "description": "Additions module for Mekanism, contains things that don't quite fit in the other modules.",
  "authors": [
    "Erfinderlabyrinth",
    "skippyall",
    "Aidancbrady",
    "Thommy101",
    "Thiakil",
    "pupnewfster",
    "dizzyd"
  ],
  "contributors": [
    "unpairedbracket",
    "CyanideX",
    "Ridanisaurus"
  ],
  "contact": {
    "repo": "https://github.com/Erfinderlabyrinth/MekanismForFabric"
  },
  "license": "MIT",
  "icon": "logo_square.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "mekanism.additions.client.AdditionsClient"
    ],
    "main": [
      "mekanism.additions.common.MekanismAdditions"
    ],
    "fabric-datagen": [
      "mekanism.additions.common.AdditionsDataGenerator"
    ],
    "modmenu": [
      "mekanism.additions.client.integration.modmenu.ToolsModMenuIntegration"
    ]
  },
  "mixins": [
    "mekanismadditions.mixins.json",
    "mekanismadditions-client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "mekanism": "${mod_version}"
  },
  "accessWidener": "mekanismadditions.accesswidener"
}
